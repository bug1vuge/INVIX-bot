# Rendered by the nginx image entrypoint (envsubst) into conf.d/default.conf.
# Variables: ${S3_BUCKET}, ${WEBHOOK_PATH}

upstream api_upstream {
    zone api_upstream 64k;
    server api:8000 resolve max_fails=2 fail_timeout=10s;
    keepalive 32;
}

upstream web_upstream {
    zone web_upstream 64k;
    server web:3000 resolve max_fails=2 fail_timeout=10s;
    keepalive 32;
}

upstream bot_upstream {
    zone bot_upstream 64k;
    server bot:8080 resolve max_fails=2 fail_timeout=10s;
    keepalive 16;
}

upstream minio_upstream {
    zone minio_upstream 64k;
    server minio:9000 resolve;
    keepalive 16;
}

# Public entrypoint, published to the host (or to the TLS edge in production).
server {
    listen 80 default_server;
    server_name _;

    client_max_body_size 1m;

    # Read-only API for browsers. Writes go through the internal listener.
    location /api/ {
        limit_except GET HEAD {
            deny all;
        }
        limit_req zone=public_api burst=40 nodelay;

        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://api_upstream;
    }

    # Telegram webhook, spread across bot replicas.
    location = ${WEBHOOK_PATH} {
        limit_except POST {
            deny all;
        }
        client_max_body_size 2m;

        include /etc/nginx/snippets/proxy.conf;
        proxy_read_timeout 60s;
        # Safe to resend a webhook call: the bot deduplicates updates by id.
        proxy_next_upstream error timeout http_502 http_503 non_idempotent;
        proxy_pass http://bot_upstream;
    }

    # Product images straight from the bucket, cached at the gateway.
    location /media/ {
        limit_except GET HEAD {
            deny all;
        }

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host minio:9000;
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header X-Amz-Bucket-Region;
        proxy_ignore_headers Set-Cookie;

        proxy_cache media;
        proxy_cache_valid 200 7d;
        proxy_cache_valid 403 404 10s;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Cache-Status $upstream_cache_status always;

        proxy_pass http://minio_upstream/${S3_BUCKET}/;
    }

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://web_upstream;
    }
}

# Internal listener for service-to-service traffic (bot -> api, web SSR -> api).
# Not published to the host.
server {
    listen 8081;
    server_name _;

    client_max_body_size 12m;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_read_timeout 60s;
        # POSTs carry an Idempotency-Key, so resending them is safe.
        proxy_next_upstream error timeout http_502 http_503 non_idempotent;
        proxy_pass http://api_upstream;
    }
}
