# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# --- public address ---------------------------------------------------------
# Domain pointing to the server; Caddy obtains a TLS certificate for it.
DOMAIN=shop.example.com
# Public HTTPS URL: the Mini App opens it, Telegram sends webhooks to it.
PUBLIC_URL=https://shop.example.com
# Host port of the gateway when running without the TLS edge (compose.yaml only).
HTTP_PORT=80

# --- telegram ---------------------------------------------------------------
BOT_TOKEN=
# Telegram user ids allowed to add products, comma separated.
ADMIN_IDS=
# webhook (production) or polling (local development without HTTPS).
BOT_MODE=webhook
WEBHOOK_SECRET=

# --- internal ---------------------------------------------------------------
SERVICE_TOKEN=

POSTGRES_USER=catalog
POSTGRES_PASSWORD=
POSTGRES_DB=catalog

MINIO_ROOT_USER=catalog
MINIO_ROOT_PASSWORD=
S3_BUCKET=products

# --- scaling ----------------------------------------------------------------
API_REPLICAS=2
BOT_REPLICAS=2
WEB_REPLICAS=2

LOG_LEVEL=INFO
