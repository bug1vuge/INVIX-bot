# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# On the server, uncomment to run with the TLS edge (Caddy) by default.
# Every docker compose / make command then uses both files.
# COMPOSE_FILE=compose.yaml:compose.prod.yaml

# --- public address ---------------------------------------------------------
# Domain pointing to the server; Caddy obtains a TLS certificate for it.
DOMAIN=shop.example.com
# Public HTTPS URL: the Mini App opens it, Telegram sends webhooks to it.
PUBLIC_URL=https://shop.example.com
# Host port of the gateway when running without the TLS edge (compose.yaml only).
HTTP_PORT=80

# --- telegram ---------------------------------------------------------------
BOT_TOKEN=
# Telegram user ids allowed to add products, comma separated.
ADMIN_IDS=
# webhook (production) or polling (local development without HTTPS).
BOT_MODE=webhook
# 16-256 characters: letters, digits, "_" and "-" (Telegram's requirement).
WEBHOOK_SECRET=

# --- internal ---------------------------------------------------------------
SERVICE_TOKEN=

POSTGRES_USER=catalog
POSTGRES_PASSWORD=
POSTGRES_DB=catalog

MINIO_ROOT_USER=catalog
# At least 8 characters, otherwise MinIO refuses to start.
MINIO_ROOT_PASSWORD=
S3_BUCKET=products

# --- scaling ----------------------------------------------------------------
API_REPLICAS=2
BOT_REPLICAS=2
WEB_REPLICAS=2

LOG_LEVEL=INFO
